# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Alpaca (https://alpaca.markets) - start with PAPER keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Market data (pick one or both)
ALPHAVANTAGE_API_KEY=
MASSIVE_API_KEY=

# Optional
FINNHUB_API_KEY=
FRED_API_KEY=
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
