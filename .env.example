# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# ---- Alpaca (https://alpaca.markets): start with PAPER keys ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# Real money needs BOTH ALPACA_PAPER_TRADE=false AND this set to yes:
I_UNDERSTAND_LIVE_TRADING=no
# iex = free data; sip = Alpaca paid data plan (better for live trading)
ALPACA_DATA_FEED=iex

# ---- Bot ----
# orb = breakout on the fixed BOT_SYMBOLS list; in_play = scan all stocks daily for the most unusual opening volume
BOT_STRATEGY=orb
BOT_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,META,TSLA
BOT_POLL_SECONDS=30

# ---- Strategy: opening range breakout (times are US/Eastern) ----
ORB_MINUTES=15
ORB_LAST_ENTRY=11:30
ORB_FLATTEN=15:55
ORB_REWARD_RISK=2.0
ORB_STOP_MODE=range
ORB_MIN_RANGE_PCT=0.002
ORB_MAX_RANGE_PCT=0.03
ORB_REQUIRE_VWAP=true
ORB_ALLOW_SHORT=false

# ---- Strategy: stocks in play (BOT_STRATEGY=in_play), see docs/strategy-research.md ----
INPLAY_TOP_N=20
INPLAY_OR_MINUTES=5
INPLAY_MIN_REL_VOLUME=1.0
INPLAY_MIN_PRICE=5
INPLAY_MIN_AVG_VOLUME=1000000
INPLAY_MIN_ATR=0.50
INPLAY_STOP_ATR_FRAC=0.10
INPLAY_ALLOW_SHORT=true
INPLAY_MAX_LEVERAGE=2.0
INPLAY_LAST_ENTRY=15:00

# ---- Risk limits ----
RISK_PER_TRADE_PCT=0.005
RISK_MAX_POSITION_PCT=0.20
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_TRADES_PER_DAY=5

# ---- Alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Other MCP data sources (optional, used by Claude, not the bot) ----
ALPHAVANTAGE_API_KEY=
MASSIVE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=
